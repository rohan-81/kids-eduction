# ==============================================================================
# KidsZone Backend Production Environment Variables
# Copy to .env and configure for your production server
# ==============================================================================

# Django Secret Key (Generate a cryptographically secure random string)
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Debug Mode (Must be False in production)
DJANGO_DEBUG=False

# Allowed Hosts (Comma-separated domain names or IP addresses)
DJANGO_ALLOWED_HOSTS=api.kidszone.example.com,kidszone.example.com,127.0.0.1,localhost

# PostgreSQL Production Database URL
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://kidszone_user:YourSecurePassword123@localhost:5432/kidszone_db

# HTTPS and Security Headers
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# CORS Allowed Origins (Comma-separated list of web or mobile origins)
CORS_ALLOWED_ORIGINS=https://kidszone.example.com,http://localhost:8081

# Optional Media & Static Storage
# MEDIA_ROOT=/var/www/kidszone/media
# STATIC_ROOT=/var/www/kidszone/staticfiles

# 3D character renders (/media/characters/*.webp, created by scripts/migrate_assets_to_db.py)
# Optional CDN origin in front of /media/; API responses then point images there.
# DJANGO_MEDIA_CDN_URL=https://cdn.kidszone.app/media
# Serve /media/ from Django when DEBUG=False (set False if nginx/S3/CDN serves it directly).
# DJANGO_SERVE_MEDIA=True
# Cache-Control max-age for media files, in seconds (default 30 days).
# DJANGO_MEDIA_CACHE_MAX_AGE=2592000
